# Canonical origin. Used for canonical URLs, sitemap, Open Graph and JSON-LD.
SITE_URL=https://blocmfb.com
# Optional. Google Tag Manager container (live site uses GTM-PN3K2MQ9). Leave empty to ship no tracking.
# Only load it after cookie consent is in place (NDPA).
PUBLIC_GTM_ID=
# Optional. HTTPS endpoint that accepts the contact form POST (JSON). Leave empty and the form tells visitors to email instead.
PUBLIC_CONTACT_ENDPOINT=
