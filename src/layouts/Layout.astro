---
import '@fontsource-variable/manrope';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import MobileMenu from '../components/MobileMenu.astro';
import { SITE } from '../data/site';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

export interface Props {
  title: string;
  description: string;
  /** Path including leading and trailing slash, e.g. "/about/". */
  path: string;
  section?: 'home' | 'personal' | 'business' | 'company';
  breadcrumb?: { name: string; path: string }[];
  faq?: { q: string; a: string }[];
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** LCP image to preload. */
  preload?: string;
}
const {
  title, description, path, section = 'home', breadcrumb = [], faq = [], schema = [],
  ogImage = '/og-default.jpg', ogType = 'website', noindex = false, preload,
} = Astro.props;

const origin = (Astro.site?.origin ?? SITE.url).replace(/\/$/, '');
const canonical = origin + path;
const ogUrl = ogImage.startsWith('http') ? ogImage : origin + ogImage;

const org = {
  '@context': 'https://schema.org',
  '@type': 'BankOrCreditUnion',
  '@id': origin + '/#organization',
  name: SITE.name,
  alternateName: SITE.short,
  url: origin + '/',
  logo: origin + '/assets/bloc-logo-navy.png',
  image: origin + '/og-default.jpg',
  description: 'Bloc Microfinance Bank is a Central Bank of Nigeria licensed microfinance bank offering personal and business banking.',
  telephone: SITE.phoneIntl,
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    addressCountry: SITE.address.country,
  },
  areaServed: { '@type': 'Country', name: 'Nigeria' },
  identifier: [
    { '@type': 'PropertyValue', name: 'RC Number', value: SITE.rc },
    { '@type': 'PropertyValue', name: 'CBN Licence Number', value: SITE.licence },
  ],
  sameAs: Object.values(SITE.social),
  contactPoint: [{ '@type': 'ContactPoint', contactType: 'customer support', telephone: SITE.phoneIntl, email: SITE.email, areaServed: 'NG', availableLanguage: 'English' }],
};
const website = {
  '@context': 'https://schema.org', '@type': 'WebSite', '@id': origin + '/#website',
  url: origin + '/', name: SITE.name, inLanguage: 'en-NG', publisher: { '@id': origin + '/#organization' },
};
const crumbs = breadcrumb.length
  ? {
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumb].map((c, i) => ({
        '@type': 'ListItem', position: i + 1, name: c.name, item: origin + c.path,
      })),
    }
  : null;
const faqLd = faq.length
  ? {
      '@context': 'https://schema.org', '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }
  : null;
const graph = [org, website, crumbs, faqLd, ...schema].filter(Boolean);
const fullTitle = title.includes('Bloc') ? title : `${title} | Bloc Microfinance Bank`;
---
<!doctype html>
<html lang="en-NG">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1'} />
  <meta name="theme-color" content="#0B2E66" />
  <meta name="format-detection" content="telephone=no" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content="en_NG" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Bloc Microfinance Bank. Banking for individuals and businesses." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@blocmfb" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogUrl} />

  <link rel="preload" as="font" type="font/woff2" href={manropeLatin} crossorigin />
  {preload && <link rel="preload" as="image" href={preload} type="image/webp" fetchpriority="high" />}
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  {SITE.gtm && (
    <script is:inline set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${SITE.gtm}');`} />
  )}
</head>
<body data-page={section}>
  {SITE.gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${SITE.gtm}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>}
  <a class="skip" href="#main">Skip to content</a>
  <div class="pg">
    <Nav section={section} />
    <main id="main"><slot /></main>
    <Footer />
  </div>
  <MobileMenu />
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
