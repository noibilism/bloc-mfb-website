---
import Layout from '../layouts/Layout.astro';
const faq = [
 {
  "q": "Is Bloc a licensed bank?",
  "a": "Yes. Bloc Microfinance Bank is licensed by the Central Bank of Nigeria. Deposits are insured by the NDIC, subject to its limits."
 },
 {
  "q": "What do I need to open an account?",
  "a": "Your phone number, email, BVN, NIN and a selfie. You do everything in the app."
 },
 {
  "q": "Why do you ask for my BVN and NIN?",
  "a": "Nigerian banks must confirm who you are. We use these details to check your identity and nothing else."
 },
 {
  "q": "How do I add money?",
  "a": "Send money to your Bloc account number from any bank or app. The app shows your number and lets you share it as an image."
 },
 {
  "q": "What if a transfer is slow?",
  "a": "The app shows it as pending. Your money is safe. If it fails, we return it and tell you when it is back."
 },
 {
  "q": "Can I use Bloc on two phones?",
  "a": "One phone is active at a time. When you move to a new phone, access pauses for a short time to protect your money."
 },
 {
  "q": "Can I save and borrow with Bloc?",
  "a": "Yes. Set a savings goal in the app. Loans need a few extra checks. We show what you pay each month before you confirm."
 },
 {
  "q": "How do I get help?",
  "a": "Chat with us in the app, or email support@blocmfb.com."
 },
 {
  "q": "Who can open a business account?",
  "a": "SMEs, growing businesses and corporates across Nigeria: registered limited companies, sole traders and growing enterprises."
 },
 {
  "q": "What is supply chain finance?",
  "a": "It gives your business access to working capital tied up in invoices or purchase orders. Instead of waiting 30, 60 or 90 days to be paid, Bloc advances the funds, and you repay on a schedule built around your cash cycle. Email support@blocmfb.com or use the app to apply."
 },
 {
  "q": "Can Bloc run my payroll?",
  "a": "Yes. Pay all your staff across different banks in one batch. Each payment is confirmed and logged."
 },
 {
  "q": "Can my team use the account?",
  "a": "Yes. You add team members and choose what each person can do."
 },
 {
  "q": "Are my deposits insured?",
  "a": "Bloc Microfinance Bank is licensed by the Central Bank of Nigeria. Deposits are insured by the NDIC, subject to its limits."
 },
 {
  "q": "How do I collect payments from customers?",
  "a": "Give each customer or branch their own account number. Payments land in your account and show in your statement."
 },
 {
  "q": "Can I connect Bloc to my own software?",
  "a": "Yes. Our API covers virtual accounts and BVN validation. Email support@blocmfb.com to talk to us."
 },
 {
  "q": "How do I get help?",
  "a": "Email support@blocmfb.com."
 }
];
---
<Layout title="Help and contact | Bloc Microfinance Bank" description="Contact Bloc Microfinance Bank by phone, email or in the app, and find answers to common personal and business banking questions." path="/help/" section="company" breadcrumb={[{"name": "Help and contact", "path": "/help/"}]} faq={faq}>
<section class="iph"><div class="w"><div class="ihl">
<nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Help</span></nav>
