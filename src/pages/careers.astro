---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Careers | Bloc Microfinance Bank" description="Careers at Bloc Microfinance Bank. See open roles and how to send us your CV." path="/careers/" section="company" breadcrumb={[{"name": "Careers", "path": "/careers/"}]} preload="/assets/photo-team.webp">
<section class="iph ph2c"><div class="w"><div class="ihl">
<nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Careers</span></nav>
<h1>Build banking people can trust.</h1>
<p class="lead">Join a licensed bank that is building products for individuals and businesses.</p>
<div class="acts"><a class="btn p" href="#cv">Send your CV</a></div>
</div><img class="ipimg" src="/assets/photo-team.webp" alt="Colleagues laughing together around a laptop" width="1536" height="1024" fetchpriority="high" decoding="async"></div></section><section class="sec" id="roles"><div class="w">
<div class="lab "><i class="ch"></i><span>Open roles</span></div>
<h2>Find your role.</h2>
<p class="lead">We do not have any open positions at the moment.</p>
<div class="ipl"><div class="ipn"><b>No open roles right now</b><span>We are always interested in talented people. Check back soon, or follow us on social media for updates.</span></div></div></div></section>
<section class="sec sky" id="hiring"><div class="w split2"><div>
<div class="lab "><i class="ch"></i><span>How we hire</span></div>
<h2>What to expect.</h2>
<p class="lead"><span class="pf">[Confirm the steps with HR]</span></p></div>
<div class="steps"><div class="step"><div class="num">1</div><div><b>Apply</b><span>Send your CV through the role page.</span></div></div><div class="step"><div class="num">2</div><div><b>Intro call</b><span>A short call to talk about you and the role.</span></div></div><div class="step"><div class="num">3</div><div><b>Interviews</b><span>Meet the team you would work with.</span></div></div><div class="step"><div class="num">4</div><div><b>Offer</b><span>We tell you our decision and next steps.</span></div></div></div></div></section>
<section class="sec" id="cv"><div class="w"><div class="cbox ch" style="display:flex;justify-content:space-between;align-items:center;gap:32px;padding:40px">
<div><h2 style="font-size:36px;line-height:42px;margin-top:0">Do not see your role?</h2><p style="margin-top:12px;font-size:18px;line-height:28px;color:var(--muted)">Send your CV to support@blocmfb.com and tell us how you would like to help.</p></div>
<a class="btn p" href="mailto:support@blocmfb.com">Send your CV <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></a></div></div></section>
</Layout>
